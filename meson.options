option('nkro', type : 'feature', value : 'enabled', description: 'NKRO support')
option('sleep', type : 'feature', value : 'enabled', description: 'Inactivity sleep (SH68F90 Power-Down mode, INT4/USB wake)')
option('rf_debug_keep_usb', type : 'boolean', value : false,
       description: 'Debug builds with wireless "euart0": keep the USB peripheral alive in wireless mode so the HID console stays readable while the radio runs. Changes the electrical setup under test - the failing case is battery-powered with USB unplugged - so it proves nothing about that case. Never ship it.')

option('debug_sink', type : 'combo', choices : ['console', 'uart', 'both'], value : 'console',
       description: 'Where dprintf output goes in debug builds: HID console only (default), UART only, or both. UART has a blocking busy-wait per byte (uart_putc), so picking it can stall the main loop while the TX shift register drains.')
